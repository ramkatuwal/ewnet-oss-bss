# =====================================================================
# EWNET OSS/BSS — Environment Configuration
#
# THIS FILE IS THE SINGLE SOURCE OF TRUTH FOR A DEPLOYMENT.
# Copy it to `.env` (install.sh does this automatically) and, for a new
# environment, change ONLY this file — domain name, TLS certificates,
# database credentials, Redis, and application keys are all injected from
# here into Nginx, Docker Compose and the Laravel app at runtime.
#
#   Fresh production install:  ./install.sh
#   Local development:         cp .env.example .env && docker compose up -d
#
# Full reference: see INSTALLATION.md (section "Environment variables").
# =====================================================================

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------

# Public root domain. Used for the Nginx server_name, SSL certificate
# paths, Sanctum/auth cookie domains, and (via APP_URL) the app's links.
# install.sh sets APP_URL / SESSION_DOMAIN / SANCTUM_STATEFUL_DOMAINS
# from this automatically when it creates a fresh `.env`.
APP_DOMAIN=localhost

APP_NAME="EWNET OSS/BSS"

# local | production | testing
APP_ENV=production

# Leave EMPTY in .env.example — `./install.sh` (or `php artisan
# key:generate`) generates a cryptographically random value on first run.
APP_KEY=

# NEVER set to true in production.
APP_DEBUG=false

# Full public URL (scheme + domain, no trailing slash).
# install.sh derives this from APP_DOMAIN (https://<domain>).
APP_URL=https://localhost

# Locale / faker (optional defaults, fine as-is).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ---------------------------------------------------------------------
# Database (PostgreSQL 17 + PostGIS 3.5)
# ---------------------------------------------------------------------
# The SAME variables drive the Laravel app container and the `postgres`
# service in docker-compose.yml. On a fresh install install.sh replaces
# DB_PASSWORD with a random value. NOTE: for an EXISTING postgres volume,
# a password change only takes effect if you also ALTER ROLE inside
# PostgreSQL (or start from a fresh volume) — see INSTALLATION.md.
DB_CONNECTION=pgsql
DB_HOST=postgres          # docker-compose service name (inside the network)
DB_PORT=5432              # postgres container port (keep 5432)
DB_DATABASE=ewnet
DB_USERNAME=ewnet
DB_PASSWORD=ewnet123      # install.sh replaces with a random value

# Optional: expose PostgreSQL on the HOST at this port (default 5432).
# Only needed for host tools (psql, test suites); uncomment to change.
# DB_HOST_PORT=5432

# ---------------------------------------------------------------------
# Redis / Cache / Queue / Sessions / Horizon
# ---------------------------------------------------------------------
REDIS_HOST=redis          # docker-compose service name
REDIS_PORT=6379
# Leave empty for "no auth". install.sh generates a strong password on
# fresh installs; when set, it is used BOTH as Redis `requirepass` and by
# Laravel (REDIS_PASSWORD).
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

# Optional: expose Redis on the HOST at this port (default 6379).
# REDIS_HOST_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=ewnet

QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=90

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.localhost  # '.' = all subdomains (e.g. .example.com)
SESSION_SECURE_COOKIE=true # always true — the app is HTTPS-only
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# Horizon dashboard (optional overrides)
# HORIZON_DOMAIN=
# HORIZON_PATH=horizon

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug           # debug | info | notice | warning | error

# ---------------------------------------------------------------------
# Authentication (Laravel Sanctum / SPA)
# ---------------------------------------------------------------------
# Comma-separated list of hosts that may send stateful (cookie) API
# requests. install.sh sets <APP_DOMAIN>,localhost,127.0.0.1 on fresh
# installs; add any additional web servers that talk to this API.
SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_PREFIX=

# ---------------------------------------------------------------------
# TLS / SSL (see INSTALLATION.md → "TLS certificates")
# ---------------------------------------------------------------------
# One of: self-signed | letsencrypt | manual
#   self-signed : a 825-day certificate is auto-generated on first start
#                 into the `certs_data` volume — zero extra configuration
#                 (client browsers will show a certificate warning).
#   letsencrypt : install.sh obtains a certificate via certbot before
#                 starting the stack (requires port 80 free + a real
#                 domain), then the app is fully HTTPS with no warnings.
#   manual      : provide your own certificates (see below).
SSL_MODE=self-signed

# Container-internal certificate paths used by the Nginx template.
# For letsencrypt install.sh rewrites these to:
#   NGINX_SSL_CERT_PATH=/etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem
#   NGINX_SSL_KEY_PATH=/etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem
NGINX_SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
NGINX_SSL_KEY_PATH=/etc/nginx/certs/privkey.pem

# Where the `web` container finds certificate files. Default is the
# `certs_data` Docker named volume. For manual mode, point this at a host
# directory that contains `fullchain.pem` and `privkey.pem` (it is then
# bind-mounted read-write into the container at /etc/nginx/certs):
#   NGINX_CERTS_SOURCE=/srv/ewnet-certs
# NGINX_CERTS_SOURCE=certs_data

# ---------------------------------------------------------------------
# Optional: SMTP / e-mail (not required for core OSS/BSS operation)
# ---------------------------------------------------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_FROM_NAME="${APP_NAME}"